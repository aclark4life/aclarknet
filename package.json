{
  "name": "python-webpack-boilerplate",
  "version": "1.0.4",
  "description": "Webpack boilerplate for Django & Flask",
  "scripts": {
    "build": "cross-env NODE_ENV=production webpack --config frontend/webpack/webpack.config.prod.js",
    "start": "webpack serve --config frontend/webpack/webpack.config.dev.js",
    "watch": "webpack --watch --config frontend/webpack/webpack.config.watch.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AccordBox/python-webpack-boilerplate"
  },
  "keywords": [
    "webpack",
    "startkit",
    "frontend"
  ],
  "author": "Michael Yin",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AccordBox/python-webpack-boilerplate/issues"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-class-properties": "^8.0.1",
    "@babel/preset-env": "^8.0.7",
    "@tailwindcss/postcss": "^4.3.4",
    "babel-loader": "^10.1.1",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-webpack-plugin": "^6.0.0",
    "mini-css-extract-plugin": "^2.9.2",
    "postcss-loader": "^8.0.0",
    "postcss-preset-env": "^11.6.2",
    "style-loader": "^4.0.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "stylelint-webpack-plugin": "^5.0.1",
    "tailwindcss": "^4.0.3",
    "webpack": "^5.112.2",
    "webpack-assets-manifest": "^6.5.5",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0",
    "webpack-merge": "^6.0.1"
  },
  "dependencies": {
    "@babel/preset-react": "^8.0.1",
    "@fortawesome/fontawesome-free": "^7.1.0",
    "bootstrap": "^5.3.8",
    "chart.js": "^4.6.1",
    "core-js": "^3.51.0",
    "prop-types": "^15.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.108.0",
    "sass-loader": "^17.1.0",
    "stylelint-config-standard-scss": "^17.0.0"
  }
}
